# Copia este fichero a .env y rellena lo que tengas.
# Sin valores, la web usa datos de ejemplo (y lo indica con una etiqueta).

# Prédicas: RSS público del podcast en Spotify for Creators
SPOTIFY_RSS_URL=https://anchor.fm/s/fb76667c/podcast/rss

# Testimonios y portada desde Sanity (documentos "testimonio" y "portada")
SANITY_PROJECT_ID=na5c11mv
SANITY_DATASET=production
# Solo si el dataset no es público
SANITY_TOKEN=

# …o testimonios desde Cloudinary: vídeos con esta etiqueta (requiere activar
# "Resource list" en Settings > Security de Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_TESTIMONIOS_TAG=testimonios
