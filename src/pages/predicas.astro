---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import PaletteSwitcher from '../components/PaletteSwitcher.astro';
import EpisodeCover from '../components/EpisodeCover.astro';
import PlayButton from '../components/PlayButton.astro';
import Testimonios from '../components/Testimonios.astro';
import Wave from '../components/Wave.astro';
import { getPredicas, formatFecha } from '../lib/predicas';
import { getPredicasEnlaces } from '../lib/predicasEnlaces';
import { site } from '../data/site';
import { useTranslations } from '../i18n/ui';

const { predicas, esEjemplo } = await getPredicas();
const enlaces = await getPredicasEnlaces();
const t = useTranslations(Astro.currentLocale);
const fecha = (d: Date) => formatFecha(d, Astro.currentLocale);
---

<Layout
  title={`${t('predicas.eyebrow')} · ${site.name}`}
  description={t('predicas.metaDescription')}
>
  <Nav current="/predicas" />
  <main id="contenido" class="overflow-x-clip">
    <header class="panel on-dark mt-[var(--inset)] bg-deep pb-[clamp(64px,8vw,110px)] pt-[160px] text-white">
      <div class="container">
        <p class="eyebrow">{t('predicas.eyebrow')}</p>
        <h1 class="display-xl mt-5 max-w-[12ch] text-[clamp(3rem,8vw,7.5rem)]">{t('predicas.titulo')}</h1>
        <Wave width={260} strokeWidth={6} draw={false} class="mt-5" />
        <p class="lead mt-7 max-w-[36rem] text-[color-mix(in_srgb,#fff_84%,var(--mist))]">
          {t('predicas.pageLead')}
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={enlaces.spotifyUrl} class="btn btn--warm">{t('predicas.seguirSpotify')} <span class="arrow" aria-hidden="true">↗</span></a>
          {enlaces.applePodcastsUrl && <a href={enlaces.applePodcastsUrl} class="btn btn--ghost">{t('predicas.applePodcasts')}</a>}
        </div>
      </div>
    </header>

    <section class="container pb-0 pt-[clamp(64px,8vw,110px)]" aria-label={t('predicas.todasAria')}>
      {esEjemplo && <p class="mb-6 inline-block rounded-full border border-dashed border-line-strong px-3 py-[6px] font-display text-xs font-semibold text-muted">{t('predicas.ejemplo')}</p>}
      <ol class="m-0 grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] list-none gap-x-6 gap-y-10 p-0" role="list">
        {
          predicas.map((p) => (
            <li class="reveal flex flex-col gap-4">
              <EpisodeCover imagen={p.imagen} fecha={p.fecha} size="l" />
              <div class="flex flex-col gap-2">
                <p class="font-display text-[0.8125rem] font-semibold text-accent">
                  {fecha(p.fecha)}
                  {p.duracion && <> · {p.duracion}</>}
                </p>
                <h2 class="text-[1.375rem] leading-[1.15] tracking-[-0.02em]">{p.titulo}</h2>
                <p class="line-clamp-3 text-base text-muted">{p.descripcion}</p>
              </div>
              <div class="mt-auto flex items-center gap-4">
                <PlayButton predica={p} />
                {p.enlace && <a href={p.enlace} class="py-3 font-display text-[0.9375rem] font-bold text-accent no-underline">{t('predicas.spotify')}</a>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <Testimonios />
  </main>
  <Footer />
  <AudioPlayer />
  {site.showPaletteSwitcher && <PaletteSwitcher />}
</Layout>
