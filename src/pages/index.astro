---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Semana from '../components/Semana.astro';
import Esencia from '../components/Esencia.astro';
import PrimeraVez from '../components/PrimeraVez.astro';
import Predicas from '../components/Predicas.astro';
import Testimonios from '../components/Testimonios.astro';
import Versiculo from '../components/Versiculo.astro';
import Visita from '../components/Visita.astro';
import Footer from '../components/Footer.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import PaletteSwitcher from '../components/PaletteSwitcher.astro';
import { site } from '../data/site';
---

<Layout>
  <Nav current="/" />
  <main id="contenido" class="overflow-x-clip">
    <Hero />
    <Marquee />
    <Semana />
    <Esencia />
    <PrimeraVez />
    <Predicas />
    <Testimonios />
    <Versiculo />
    <Visita />
  </main>
  <Footer />
  <AudioPlayer />
  {site.showPaletteSwitcher && <PaletteSwitcher />}
</Layout>
