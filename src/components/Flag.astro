---
/**
 * Banderitas de España y Galicia para el selector de idioma. Colores reales
 * de cada bandera (no son tokens de marca: excepción igual que el #fff del logo).
 */
import type { Locale } from '../i18n/ui';
interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className = 'h-[0.85em] w-auto rounded-[2px]' } = Astro.props;
---

{locale === 'es' ? (
  <svg viewBox="0 0 3 2" class={className} aria-hidden="true">
    <rect width="3" height="2" fill="#AA151B" />
    <rect y="0.5" width="3" height="1" fill="#F1BF00" />
  </svg>
) : (
  <svg viewBox="0 0 3 2" class={className} aria-hidden="true">
    <rect width="3" height="2" fill="#fff" />
    <polygon points="0,0 0,0.7 2.3,2 3,2 3,1.3 0.7,0" fill="#0090C7" />
  </svg>
)}
