---
import EpisodeCover from './EpisodeCover.astro';
import PlayButton from './PlayButton.astro';
import { getPredicas, formatFecha } from '../lib/predicas';
import { getPredicasEnlaces } from '../lib/predicasEnlaces';
import { useTranslations, localizedHref } from '../i18n/ui';

const { predicas, esEjemplo } = await getPredicas();
const enlaces = await getPredicasEnlaces();
const [ultima, ...resto] = predicas;
const siguientes = resto.slice(0, 3);
const t = useTranslations(Astro.currentLocale);
const href = (h: string) => localizedHref(Astro.currentLocale, h);
const fecha = (d: Date) => formatFecha(d, Astro.currentLocale);
---

<section id="predicas" class="pb-[clamp(60px,7vw,96px)] pt-[clamp(100px,12vw,160px)]" aria-labelledby="predicas-title">
  <div class="container">
    <header class="reveal flex flex-wrap items-end justify-between gap-x-16 gap-y-6">
      <div>
        <p class="eyebrow">{t('predicas.eyebrow')}</p>
        <h2 id="predicas-title" class="display-l mt-4">{t('predicas.titulo')}</h2>
      </div>
      <div class="flex max-w-[28rem] flex-col gap-5">
        <p class="lead">{t('predicas.lead')}</p>
        <div class="flex flex-wrap gap-[10px]">
          <a href={enlaces.spotifyUrl} class="btn">{t('predicas.seguirSpotify')} <span class="arrow" aria-hidden="true">↗</span></a>
          {enlaces.applePodcastsUrl && (
            <a href={enlaces.applePodcastsUrl} class="btn btn--ghost">{t('predicas.applePodcasts')}</a>
          )}
        </div>
      </div>
    </header>

    {esEjemplo && <p class="mt-6 inline-block rounded-full border border-dashed border-line-strong px-3 py-[6px] font-display text-xs font-semibold text-muted">{t('predicas.ejemplo')}</p>}

    {
      ultima && (
        <div class="mt-[clamp(40px,5vw,64px)] grid grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-4 max-[1000px]:grid-cols-1">
          <article class="on-dark reveal grid grid-cols-[minmax(0,5fr)_minmax(0,6fr)] items-center gap-[clamp(20px,3vw,36px)] rounded-[var(--radius-l)] bg-deep p-[clamp(16px,2vw,24px)] text-white max-[620px]:grid-cols-1">
            <EpisodeCover imagen={ultima.imagen} fecha={ultima.fecha} size="l" class="w-full" />
            <div class="flex flex-col gap-3 pr-[clamp(0px,2vw,16px)]">
              <p class="eyebrow">{t('predicas.ultimaPredica')}</p>
              <h3 class="mt-1 text-[clamp(1.75rem,2.8vw,2.5rem)] leading-[1.05]">{ultima.titulo}</h3>
              <p class="font-display text-sm font-semibold text-[color-mix(in_srgb,#fff_78%,var(--mist))]">
                {fecha(ultima.fecha)}
                {ultima.duracion && <> · {ultima.duracion}</>}
              </p>
              <p class="line-clamp-3 text-[1.0625rem] text-[color-mix(in_srgb,#fff_86%,var(--mist))]">{ultima.descripcion}</p>
              <div class="mt-2 flex items-center gap-[18px]">
                <PlayButton predica={ultima} size="l" tone="warm" />
                {ultima.enlace && <a href={ultima.enlace} class="py-3 font-display text-[0.9375rem] font-bold no-underline">{t('predicas.abrirSpotify')}</a>}
              </div>
            </div>
          </article>

          <div class="reveal flex flex-col rounded-[var(--radius-l)] border border-line bg-surface p-[10px_clamp(16px,2vw,24px)_18px]">
            <ol class="m-0 list-none p-0" role="list">
              {siguientes.map((p) => (
                <li class="grid grid-cols-[72px_minmax(0,1fr)_auto] items-center gap-4 border-b border-line py-[14px]">
                  <EpisodeCover imagen={p.imagen} fecha={p.fecha} class="w-[72px]" />
                  <div>
                    <h3 class="text-[1.0625rem] leading-[1.25] tracking-[-0.015em]">{p.titulo}</h3>
                    <p class="mt-1 text-sm text-muted">
                      {fecha(p.fecha)}
                      {p.duracion && <> · {p.duracion}</>}
                    </p>
                  </div>
                  <PlayButton predica={p} />
                </li>
              ))}
            </ol>
            <a href={href('/predicas')} class="group mt-auto inline-flex min-h-11 items-center gap-2 pt-[18px] font-display font-bold text-accent no-underline">
              {t('predicas.verTodas')} <span class="arrow inline-block transition-transform duration-[0.35s] ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>
