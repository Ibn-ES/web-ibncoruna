---
import { getDomingo } from '../lib/domingo';

const domingo = await getDomingo();

const preguntas = [
  { q: '¿Cuándo es?', a: `Los domingos a las ${domingo.hora}. Ven cuando quieras, te guardamos sitio.`, open: true },
  { q: '¿Dónde estáis?', a: domingo.direccionCompleta, link: { href: domingo.mapaUrl, label: 'Cómo llegar ↗' } },
  { q: '¿Cuánto dura?', a: domingo.duracion },
  { q: '¿Qué pasa en un domingo?', a: domingo.resumen },
  { q: '¿Y si vengo con niños?', a: domingo.ninos },
  { q: '¿Tengo que saber algo antes?', a: 'No. Ven como eres y trae a quien quieras.' },
];
---

<section id="visitanos" class="pv panel on-dark bg-deep py-[clamp(80px,10vw,140px)] text-white" aria-labelledby="pv-title">
  <div class="container grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start gap-x-[clamp(40px,7vw,120px)] gap-y-14 max-[900px]:grid-cols-1">
    <div class="min-w-0">
      <div class="sticky top-[120px] flex flex-col items-start gap-5 max-[900px]:static">
        <p class="eyebrow">¿Primera vez?</p>
        <h2 id="pv-title" class="display-l">Te esperamos en la puerta.</h2>
        <p class="lead mb-3 text-[color-mix(in_srgb,#fff_84%,var(--mist))]">
          Solo tienes que venir. Si nos avisas antes, alguien te recibirá al llegar y te acompañará dentro.
        </p>
        <a href="#contacto" class="btn btn--warm">Planifica tu visita <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="border-t border-[color-mix(in_srgb,#fff_22%,transparent)]">
      {preguntas.map((p) => (
        <details
          name="primera-vez"
          open={p.open}
          class="faq__item group border-b border-[color-mix(in_srgb,#fff_22%,transparent)] [interpolate-size:allow-keywords]"
        >
          <summary class="flex list-none cursor-pointer items-center justify-between gap-6 py-[26px] font-display text-[clamp(1.25rem,2vw,1.625rem)] font-bold tracking-[-0.02em] [&::-webkit-details-marker]:hidden">
            <span>{p.q}</span>
            <span
              class="relative h-11 w-11 flex-none rounded-full border border-[color-mix(in_srgb,#fff_30%,transparent)] transition-[background-color,transform] duration-[0.4s] ease-out before:absolute before:left-1/2 before:top-1/2 before:-ml-[7px] before:-mt-px before:h-0.5 before:w-3.5 before:rounded-sm before:bg-current before:content-[''] after:absolute after:left-1/2 after:top-1/2 after:-ml-[7px] after:-mt-px after:h-0.5 after:w-3.5 after:rotate-90 after:rounded-sm after:bg-current after:transition-transform after:duration-[0.4s] after:ease-out after:content-[''] group-open:border-warm group-open:bg-warm group-open:text-deep group-open:after:rotate-0"
              aria-hidden="true"
            ></span>
          </summary>
          <div class="faq__answer pb-7 pl-0 pr-16 pt-0 text-[1.1875rem] text-[color-mix(in_srgb,#fff_86%,var(--mist))] max-[900px]:pr-0">
            <p>{p.a}</p>
            {p.link && <a class="mt-[10px] inline-block font-display font-bold text-warm no-underline" href={p.link.href}>{p.link.label}</a>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* ::details-content (apertura animada del <details>) no tiene variante de
     utilidad en Tailwind: se queda en CSS. */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }
  .faq__item[open]::details-content {
    block-size: auto;
  }
</style>
