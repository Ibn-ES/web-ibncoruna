---
import Photo from './Photo.astro';
import { getDomingo } from '../lib/domingo';
import { getJovenes } from '../lib/jovenes';
import { useTranslations, localizedHref } from '../i18n/ui';

const domingo = await getDomingo(Astro.currentLocale);
const jovenes = await getJovenes(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const href = (h: string) => localizedHref(Astro.currentLocale, h);
---

<section class="pb-[clamp(80px,10vw,140px)] pt-[clamp(120px,14vw,180px)]" aria-labelledby="semana-title">
  <div class="container">
    <header class="reveal mb-[clamp(40px,5vw,64px)] flex flex-wrap items-end justify-between gap-x-16 gap-y-6">
      <div>
        <p class="eyebrow">{t('semana.eyebrow')}</p>
        <h2 id="semana-title" class="display-l mt-4">{t('semana.titulo')}</h2>
      </div>
      <p class="lead max-w-[26rem]">{t('semana.lead')}</p>
    </header>

    <div class="grid grid-cols-12 gap-4 [grid-auto-rows:minmax(300px,auto)] max-[900px]:grid-cols-1">
      <!-- Domingos -->
      <article class="reveal group relative col-span-7 row-span-2 flex cursor-pointer flex-col overflow-hidden rounded-[var(--radius-l)] bg-mist transition-[transform,box-shadow] duration-500 ease-out hover:-translate-y-1 hover:shadow-[0_30px_60px_-36px_color-mix(in_srgb,var(--deep)_70%,transparent)] max-[900px]:col-auto max-[900px]:row-auto">
        {
          domingo.fotoDestacadaUrl ? (
            <img
              src={domingo.fotoDestacadaUrl}
              alt=""
              class="m-[12px_12px_0] min-h-[280px] flex-1 basis-[280px] rounded-[calc(var(--radius-l)-12px)] object-cover max-[900px]:min-h-[240px]"
            />
          ) : (
            <Photo label={t('semana.fotoLabel')} class="m-[12px_12px_0] min-h-[280px] flex-1 basis-[280px] max-[900px]:min-h-[240px]" tone="soft" />
          )
        }
        <div class="relative mt-auto flex flex-col items-start gap-3 p-[clamp(24px,3vw,36px)]">
          <span class="inline-flex min-h-8 items-center rounded-full bg-btn px-[14px] font-display text-[0.8125rem] font-semibold text-white">{domingo.hora} · {domingo.direccion}</span>
          <h3 class="display-m">{t('semana.domingosTitulo')}</h3>
          <p class="max-w-[30rem]">{t('semana.domingosTexto')}</p>
          <a href={href('/#visitanos')} class="relative mt-2 inline-flex min-h-11 items-center gap-2 font-display text-base font-bold text-accent no-underline after:absolute after:inset-0 after:content-['']">
            {t('semana.comoEsDomingo')} <span class="arrow inline-block transition-transform duration-[0.35s] ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <!-- Jóvenes -->
      <article id="jovenes" class="reveal group relative col-span-5 flex cursor-pointer flex-col overflow-hidden rounded-[var(--radius-l)] bg-warm text-deep [scroll-margin-top:120px] transition-[transform,box-shadow] duration-500 ease-out hover:-translate-y-1 hover:shadow-[0_30px_60px_-36px_color-mix(in_srgb,var(--deep)_70%,transparent)] max-[900px]:col-auto">
        <span
          class="absolute -top-[0.18em] right-[0.06em] font-display text-[clamp(9rem,16vw,13rem)] font-extrabold leading-none tracking-[-0.06em] text-[color-mix(in_srgb,var(--deep)_14%,transparent)] transition-transform duration-[0.6s] ease-out group-hover:rotate-[-8deg] group-hover:scale-[1.04]"
          aria-hidden="true"
        >
          ¿?
        </span>
        <div class="relative mt-auto flex flex-col items-start gap-3 p-[clamp(24px,3vw,36px)]">
          <span class="inline-flex min-h-8 items-center rounded-full bg-deep px-[14px] font-display text-[0.8125rem] font-semibold text-white">{jovenes.cuando}</span>
          <h3 class="display-m">{jovenes.nombre}</h3>
          <p class="max-w-[30rem]">{t('semana.jovenesTexto')}</p>
          <a href={`https://instagram.com/${jovenes.instagram}`} class="relative mt-2 inline-flex min-h-11 items-center gap-2 font-display text-base font-bold no-underline after:absolute after:inset-0 after:content-['']">
            @{jovenes.instagram} <span class="arrow inline-block transition-transform duration-[0.35s] ease-out group-hover:translate-x-1" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <!-- Primera visita -->
      <article class="on-dark reveal group relative col-span-5 flex cursor-pointer flex-col overflow-hidden rounded-[var(--radius-l)] bg-deep text-white transition-[transform,box-shadow] duration-500 ease-out hover:-translate-y-1 hover:shadow-[0_30px_60px_-36px_color-mix(in_srgb,var(--deep)_70%,transparent)] max-[900px]:col-auto">
        <div class="relative mt-auto flex flex-col items-start gap-3 p-[clamp(24px,3vw,36px)]">
          <h3 class="display-m pr-[72px]">{t('semana.primeraVisitaTitulo')}</h3>
          <p class="max-w-[22rem] text-[color-mix(in_srgb,#fff_82%,var(--mist))]">{t('semana.primeraVisitaTexto')}</p>
          <a
            href={href('/#visitanos')}
            class="absolute right-[clamp(24px,3vw,36px)] top-[clamp(24px,3vw,36px)] flex h-[60px] w-[60px] items-center justify-center rounded-full bg-warm text-deep transition-transform duration-500 ease-out after:absolute after:inset-0 after:content-[''] group-hover:rotate-45"
            aria-label={t('semana.primeraVisitaAria')}
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
