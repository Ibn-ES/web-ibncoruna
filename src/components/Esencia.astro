---
import Wave from './Wave.astro';
import { getEsencia } from '../lib/esencia';
import { useTranslations } from '../i18n/ui';

const esencia = await getEsencia(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<section id="quienes" class="pb-[clamp(100px,12vw,160px)] pt-[clamp(80px,10vw,140px)]" aria-labelledby="esencia-title">
  <div class="container">
    <p class="eyebrow reveal">{t('esencia.eyebrow')}</p>
    <h2 id="esencia-title" class="reveal mt-6 max-w-[16ch] text-[clamp(2.5rem,6.4vw,5.75rem)] leading-none tracking-[-0.045em]">
      {t('esencia.tituloPre')}{' '}<span class="relative inline-block text-accent">{t('esencia.tituloFe')}<Wave width={140} strokeWidth={6} stretch class="absolute -bottom-[0.16em] -left-[6%] h-[0.22em] w-[112%]" /></span>{t('esencia.tituloPost')}
    </h2>

    <div class="mt-[clamp(56px,7vw,96px)] grid grid-cols-[minmax(0,4fr)_minmax(0,8fr)] items-start gap-x-[clamp(40px,6vw,96px)] gap-y-10 max-[960px]:grid-cols-1">
      <p class="lead reveal">{t('esencia.lead')}</p>

      <ol class="m-0 grid list-none grid-cols-3 gap-4 p-0 max-[640px]:grid-cols-1" role="list">
        {esencia.map((v, i) => (
          <li class="reveal flex min-h-[260px] flex-col gap-[10px] rounded-[var(--radius-l)] border border-line bg-surface p-[28px_26px_32px] max-[640px]:min-h-0">
            <span class="mb-auto font-display text-[0.875rem] font-bold tracking-[0.1em] text-accent" aria-hidden="true">0{i + 1}</span>
            <h3 class="mt-10 text-[clamp(1.75rem,2.6vw,2.25rem)] max-[640px]:mt-4">{v.titulo}</h3>
            <p>{v.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
