---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLema } from '../lib/lema';
import { getContacto } from '../lib/contacto';
import { useTranslations, localizedHref } from '../i18n/ui';

const year = new Date().getFullYear();
const lema = await getLema(Astro.currentLocale);
const contacto = await getContacto(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const href = (h: string) => localizedHref(Astro.currentLocale, h);

const nombreRed: Record<string, string> = {
  instagram: 'Instagram',
  whatsapp: 'WhatsApp',
  spotify: 'Spotify',
  apple: 'Apple Podcasts',
  youtube: 'YouTube',
};
---

<footer class="on-dark bg-deep pb-8 pt-[clamp(64px,8vw,100px)] text-white">
  <div class="container @container flex w-full flex-col">
    <div class="flex flex-wrap justify-between gap-10">
      <div>
        <Logo size="l" tone="white" />
        <p class="mt-5 max-w-[22rem] text-[color-mix(in_srgb,#fff_82%,var(--mist))]">{lema.principal} {lema.secundario}</p>
        {contacto.redes.length > 0 && (
          <ul class="m-0 mt-6 flex list-none items-center gap-4 p-0" role="list">
            {contacto.redes.map((r) => (
              <li>
                <a
                  class="grid h-11 w-11 place-items-center rounded-full border border-[color-mix(in_srgb,#fff_25%,transparent)] text-white no-underline transition-colors duration-200 hover:border-warm hover:text-warm"
                  href={r.url}
                  aria-label={r.etiqueta || nombreRed[r.tipo]}
                >
                  <Icon name={r.tipo} class="h-5 w-5" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <nav aria-label={t('footer.aria')}>
        <ul class="m-0 list-none p-0" role="list">
          {site.nav.map((i) => <li><a class="block py-2 font-display font-semibold no-underline hover:text-warm" href={href(i.href)}>{t(`nav.${i.key}`)}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-[color-mix(in_srgb,#fff_20%,transparent)] pt-[22px] text-[0.9375rem] text-[color-mix(in_srgb,#fff_80%,var(--mist))]">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span>© {year} {site.name} · {site.shortName}</span>
        <a class="no-underline hover:text-warm" href={href('/legal')}>{t('footer.avisoLegal')}</a>
        <a class="no-underline hover:text-warm" href={href('/privacidad')}>{t('footer.privacidad')}</a>
      </div>
      <a class="no-underline" href="#top">{t('footer.volverArriba')}</a>
    </div>
  </div>
</footer>
