---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import '../styles/global.css';
import { site } from '../data/site';
import { getLema } from '../lib/lema';
import { getDomingo } from '../lib/domingo';
import { getContacto } from '../lib/contacto';
import { esLocale, useTranslations } from '../i18n/ui';
import PrivacidadAviso from '../components/PrivacidadAviso.astro';

interface Props {
  title?: string;
  description?: string;
}

const locale = esLocale(Astro.currentLocale);
const t = useTranslations(locale);
const lema = await getLema(locale);
const domingo = await getDomingo(locale);
const contacto = await getContacto(locale);

const { title = `${site.name} · ${lema.principal} ${lema.secundario}`, description = t('layout.description') } =
  Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

// Alternativa en el otro idioma de la misma página (es en la raíz, gl con prefijo /gl).
const pathSinPrefijo = locale === 'gl' ? Astro.url.pathname.replace(/^\/gl/, '') || '/' : Astro.url.pathname;
const pathEs = pathSinPrefijo;
const pathGl = `/gl${pathSinPrefijo === '/' ? '' : pathSinPrefijo}`;

// Datos estructurados (schema.org): solo en la portada, para no repetirlos en cada página.
const esPortada = pathSinPrefijo === '/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: site.name,
  alternateName: site.shortName,
  url: String(new URL(locale === 'gl' ? '/gl/' : '/', Astro.site)),
  logo: String(ogImage),
  image: String(ogImage),
  description: t('layout.description'),
  address: {
    '@type': 'PostalAddress',
    streetAddress: domingo.direccionCompleta,
    addressLocality: 'A Coruña',
    addressCountry: 'ES',
  },
  email: contacto.email,
  sameAs: [`https://instagram.com/${contacto.instagram}`],
};
---

<!doctype html>
<html lang={locale} data-palette={site.defaultPalette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(pathEs, Astro.site)} />
    <link rel="alternate" hreflang="gl" href={new URL(pathGl, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(pathEs, Astro.site)} />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b2545" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'gl' ? 'gl_ES' : 'es_ES'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {esPortada && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!--
      Paleta: ?paleta=a|b|c en la URL la fija (y se recuerda en este navegador).
      Va en línea y antes de pintar para que no haya parpadeo de colores.
    -->
    <script is:inline>
      (() => {
        try {
          const valid = ['a', 'b', 'c'];
          const fromUrl = new URLSearchParams(location.search).get('paleta');
          if (valid.includes(fromUrl)) localStorage.setItem('bn-paleta', fromUrl);
          const saved = localStorage.getItem('bn-paleta');
          if (valid.includes(saved)) document.documentElement.dataset.palette = saved;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="absolute left-4 top-[-60px] z-[200] rounded-xl bg-deep px-[18px] py-3 font-display font-bold text-white no-underline focus:top-4" href="#contenido">{t('layout.saltarContenido')}</a>
    <slot />
    <PrivacidadAviso />
  </body>
</html>
